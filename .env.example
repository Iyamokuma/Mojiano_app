# Supabase Postgres via the IPv4 session/transaction pooler.
# Copy the URI from Project Settings → Database. Encode @ in the password as %40.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:[YOUR-DB-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:[YOUR-DB-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

AUTH_SECRET="replace-with-a-long-random-secret"

ADMIN_EMAIL="admin@mojiano.local"
ADMIN_PASSWORD="ChangeThisPassword123!"

SITE_URL="http://localhost:3002"
# On Vercel set SITE_URL to the live origin, e.g. https://mojiano.co.uk
PORT="4000"

# Optional: Stripe card payments. Leave empty to use bank transfer / cash on delivery.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VITE_STRIPE_PUBLISHABLE_KEY=""

# Resend (https://resend.com) — verify your domain, then send from e.g. orders@mojiano.co.uk
RESEND_API_KEY=""
EMAIL_FROM="Mojiano <orders@mojiano.co.uk>"
# Optional: admin copies of paid-order alerts (defaults to ADMIN_EMAIL)
# ORDER_ALERT_EMAIL="admin@mojiano.co.uk"
