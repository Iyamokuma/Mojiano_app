{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "prisma generate && node scripts/bundle-api.mjs && vite build",
  "outputDirectory": "dist",
  "regions": ["lhr1"],
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "{api/_app.js,node_modules/.prisma/client/**}"
    },
    "api/[[...path]].js": {
      "maxDuration": 30,
      "includeFiles": "{api/_app.js,node_modules/.prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server?__path=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/uploads/:path*" },
    { "source": "/((?!api/|uploads/|assets/|brand/|hero/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/hero/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/api/home",
      "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=90, stale-while-revalidate=600" }]
    },
    {
      "source": "/api/products",
      "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=45, stale-while-revalidate=300" }]
    }
  ]
}
